<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://mlgaard.dk/tvhomekey" version="1.0.1" viewmodes="maximized">
    <tizen:application id="HDvHomeKey.Go" package="HDvHomeKey" required_version="6.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>Home key</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <!-- Only the log server on the PC (logserver.mjs) -->
    <access origin="http://192.168.1.10:8766" subdomains="false"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
